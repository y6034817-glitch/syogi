# 通常は設定不要です（src/online/config.ts に既定値が入っています）。
# 別の Supabase プロジェクトを使うときだけ .env にコピーして書き換えてください。
# service_role キーは絶対に書かないでください。
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
# ユーザー名ログイン用の疑似メールのドメイン（登録時にメール形式エラーが出る場合に変更）
VITE_AUTH_EMAIL_DOMAIN=shogi.local
