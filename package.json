{
  "name": "shogi-online",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "オンライン将棋（Vite + TypeScript + Supabase）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:rules": "node scripts/test-rules.ts",
    "test:replay": "node scripts/test-replay.ts",
    "test": "npm run test:rules && npm run test:replay",
    "sync:functions": "node scripts/sync-shared.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
